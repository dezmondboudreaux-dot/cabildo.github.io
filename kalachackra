  <style>
    /* exactly the same base style as homepage */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background-color: #000000;
      color: #00FFFF;
      font-family: 'Courier New', 'VT323', 'Fira Code', monospace;
      line-height: 1.5;
      font-size: 16px;
      padding: 1.5rem;
    }
    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: repeating-linear-gradient(0deg, rgba(0,255,255,0.02) 0px, rgba(0,255,255,0.02) 2px, transparent 2px, transparent 6px);
      pointer-events: none;
      z-index: 999;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }
    h1, h2, h3, .logo-text, .nav a {
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    h1 {
      font-size: 2.8rem;
      color: #FFFFFF;
      text-shadow: 0 0 3px #00FFFF;
    }
    h2 {
      font-size: 1.8rem;
      border-left: 4px solid #FF00FF;
      padding-left: 1rem;
      margin: 2rem 0 1rem 0;
      color: #FFFFFF;
    }
    h3 {
      font-size: 1.2rem;
      color: #00FFFF;
      margin-bottom: 0.5rem;
    }
    a {
      color: #00FFFF;
      text-decoration: none;
      transition: 0.2s;
    }
    a:hover {
      color: #FF00FF;
      text-shadow: 0 0 2px #FF00FF;
    }
    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 2rem;
      border-bottom: 1px solid #00FFFF;
      margin-bottom: 2rem;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .logo svg {
      width: 50px;
      height: 50px;
    }
    .logo-text {
      font-size: 1.4rem;
      letter-spacing: 3px;
      color: #FFFFFF;
    }
    .logo-text span {
      color: #FF00FF;
    }
    nav ul {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    nav a {
      font-size: 1rem;
      padding: 0.25rem 0;
      border-bottom: 1px solid transparent;
    }
    nav a:hover {
      border-bottom-color: #FF00FF;
    }
    .btn {
      display: inline-block;
      background: transparent;
      border: 1px solid #00FFFF;
      color: #00FFFF;
      padding: 0.6rem 1.2rem;
      font-family: inherit;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn:hover {
      background: #00FFFF;
      color: #000000;
      box-shadow: 0 0 8px #00FFFF;
    }
    .btn-magenta {
      border-color: #FF00FF;
      color: #FF00FF;
    }
    .btn-magenta:hover {
      background: #FF00FF;
      color: #000000;
    }
    .issue-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }
    .issue-card {
      background: #0A0A0A;
      border: 1px solid #00FFFF;
      padding: 1.2rem;
      transition: 0.2s;
    }
    .issue-card:hover {
      border-color: #FF00FF;
      box-shadow: 0 0 5px #FF00FF;
    }
    .issue-title {
      font-size: 1.3rem;
      color: #FFFFFF;
      border-bottom: 1px dashed #FF00FF;
      display: inline-block;
      margin-bottom: 0.75rem;
    }
    .issue-meta {
      font-size: 0.8rem;
      color: #FF00FF;
      margin-bottom: 1rem;
    }
    .pdf-icon {
      display: inline-block;
      width: 24px;
      text-align: center;
      margin-right: 8px;
    }
    .footer-links {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid #00FFFF;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      font-size: 0.8rem;
    }
    @media (max-width: 700px) {
      body { padding: 1rem; }
      header { flex-direction: column; text-align: center; }
      nav ul { gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem; }
      .issue-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
